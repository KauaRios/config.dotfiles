{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/Queen Marika-transparent.png\"",
    "width": 26,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4
    },
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "@primary@",
      "title": "@secondary@",
      "output": "@on_surface@"
    },
    "showErrors": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;@primary_ansi@}          M A R I K A{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;@secondary_ansi@}        THE ETERNAL QUEEN{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;@outline_ansi@}  ─────────── ◇ ───────────{#}"
    },
    "break",
    {
      "type": "title",
      "key": "  Tarnished",
      "format": "{user-name}"
    },
    {
      "type": "os",
      "key": "  Realm    ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "  Kernel   ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  Session  ",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  Terminal "
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;@secondary_ansi@}  ◇  VITALS{#}"
    },
    {
      "type": "cpu",
      "key": "  CPU      ",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "  Heat     ",
      "temp": true,
      "format": "{temperature}"
    },
    {
      "type": "memory",
      "key": "  Memory   ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "  Storage  ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": "  Awake    "
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;@outline_ansi@}  ─────────── ◇ ───────────{#}"
    },
    {
      "type": "custom",
      "format": "  {#38;2;@primary_ansi@}● ● ●{#}   {#38;2;@secondary_ansi@}● ● ●{#}   {#38;2;@outline_ansi@}● ● ●{#}"
    }
  ]
}
