{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/ronin.txt\"",
    "color": {
      "1": "@primary@"
    },
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    },
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "48;2;@outline_ansi@;38;2;@surface_ansi@",
      "title": "@primary@",
      "output": "@on_surface@"
    },
    "showErrors": false
  },
  "modules": [
    {
      "type": "os",
      "key": "  ",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "{#48;2;@outline_ansi@}{#38;2;@surface_ansi@} SYSTEM    {#}"
    },
    {
      "type": "os",
      "key": " OS ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": " KE ",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": " UP "
    },
    {
      "type": "packages",
      "key": " PK "
    },
    "break",
    {
      "type": "custom",
      "format": "{#48;2;@outline_ansi@}{#38;2;@surface_ansi@} SOFTWARE  {#}"
    },
    {
      "type": "wm",
      "key": " WM ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": " SH ",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": " TR ",
      "format": "{pretty-name}"
    },
    {
      "type": "font",
      "key": " FT "
    },
    "break",
    {
      "type": "custom",
      "format": "{#48;2;@outline_ansi@}{#38;2;@surface_ansi@} HARDWARE  {#}"
    },
    {
      "type": "cpu",
      "key": " CP ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": " GP ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " RA ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " DI ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({filesystem})"
    },
    {
      "type": "cpu",
      "key": " CT ",
      "temp": true,
      "format": "{temperature}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;@on_surface_ansi@}▪ ▪ {#38;2;@outline_ansi@}▪ ▪ {#38;2;@secondary_ansi@}▪ ▪ {#38;2;@primary_ansi@}▪ ▪{#}"
    }
  ]
}
