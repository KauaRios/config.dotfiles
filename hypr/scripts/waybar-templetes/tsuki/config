{
  "layer": "top",
  "position": "top",
  "height": 52,
  "margin-top": 12,
  "margin-left": 18,
  "margin-bottom": 0,
  "margin-right": 18,
  "spacing": 0,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "mpris"
  ],
  "modules-center": [
    "clock",
    "clock#date"
  ],
  "modules-right": [
    "tray",
    "network",
    "wireplumber",
    "battery",
    "custom/lock"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "format-icons": {
      "active": "●",
      "default": "○",
      "empty": "·",
      "persistent": "·",
      "urgent": "!"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M:%S}"
  },
  "wireplumber": {
    "format": "<span size=\"x-small\">VOLUME</span>\n{volume}%",
    "format-muted": "<span size=\"x-small\">VOLUME</span>\nMUDO",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%"
  },
  "network": {
    "format-wifi": "⌁",
    "format-ethernet": "⇆",
    "format-disconnected": "⊘",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "max-length": 12,
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size=\"x-small\">BATERIA</span>\n{capacity}%",
    "format-charging": "<span size=\"x-small\">CARGA</span>\nϟ {capacity}%",
    "format-plugged": "<span size=\"x-small\">TOMADA</span>\n{capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "tray": {
    "spacing": 8,
    "icon-size": 14
  },
  "custom/lock": {
    "format": "⏻",
    "on-click": "hyprlock",
    "tooltip-format": "Bloquear a sessão"
  },
  "custom/launcher": {
    "format": "☾  <span size=\"small\" weight=\"bold\" letter_spacing=\"1800\">TSUKI</span>",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "clock#date": {
    "format": "<span size=\"small\" weight=\"bold\">{:%a}</span>\n{:%d %b}",
    "tooltip": false
  },
  "mpris": {
    "format": "♪  {title}",
    "format-paused": "Ⅱ  {title}",
    "max-length": 19,
    "tooltip": true
  }
}
