{
  "name": "ronin",
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 18,
  "margin-right": 18,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "group/navigation"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/status",
    "clock",
    "clock#date"
  ],
  "custom/menu": {
    "format": "menu",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "​",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },
  "custom/next": {
    "format": "​",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip-format": "Próximo workspace"
  },
  "custom/previous": {
    "format": "​",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "tooltip-format": "Workspace anterior"
  },
  "idle_inhibitor": {
    "format": "​",
    "tooltip-format": "Inibir suspensão: {status}"
  },
  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "Mudo",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Volume: {volume}%\nClique: mudo · botão direito: controle de volume"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%H:%M:%S}",
    "tooltip-format": "{calendar}"
  },
  "clock#date": {
    "format": "{:%d %b}",
    "tooltip": false
  },
  "group/navigation": {
    "orientation": "horizontal",
    "modules": [
      "custom/previous",
      "hyprland/workspaces",
      "custom/next"
    ]
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "temperature",
      "idle_inhibitor",
      "wireplumber"
    ]
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 32,
    "separate-outputs": true,
    "fallback": "Ronin",
    "tooltip-format": "{title}"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "CPU {temperatureC}°",
    "tooltip-format": "CPU Ryzen · Tctl: {temperatureC}°C"
  }
}
