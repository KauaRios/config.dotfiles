{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "margin-left": 12,
  "margin-bottom": 0,
  "margin-right": 12,
  "spacing": 1,
  "modules-left": [
    "custom/brand",
    "clock",
    "custom/lock",
    "group/music"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "network",
    "wireplumber",
    "power-profiles-daemon",
    "memory",
    "cpu",
    "temperature",
    "battery"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "format-icons": {
      "active": "​",
      "default": "•",
      "empty": "•",
      "persistent": "•",
      "urgent": "!"
    }
  },
  "clock": {
    "format": "{:%H:%M %d/%m/%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "▦  {:%d.%m.%Y}"
  },
  "cpu": {
    "interval": 2,
    "format": "◉ {usage}%",
    "max-length": 10,
    "tooltip-format": "Processador: {usage}%"
  },
  "memory": {
    "interval": 10,
    "format": "▤ {used:.1f}G",
    "tooltip-format": "Memória: {used:.1f} / {total:.1f} GiB"
  },
  "wireplumber": {
    "format": "♪ {volume}%",
    "format-muted": "♩  —",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%"
  },
  "network": {
    "format-wifi": "⌁ {signalStrength}%",
    "format-ethernet": "⇆",
    "format-disconnected": "⊘",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "max-length": 8,
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "▰ {capacity}%",
    "format-charging": "ϟ  {capacity}%",
    "format-plugged": "ϟ  {capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "tray": {
    "spacing": 5,
    "icon-size": 14
  },
  "custom/lock": {
    "format": "⏻",
    "on-click": "hyprlock",
    "tooltip-format": "Bloquear a sessão"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "power-saver": "♧",
      "balanced": "◐",
      "performance": "ϟ"
    },
    "tooltip-format": "Energia: {profile}\nClique para trocar o perfil"
  },
  "custom/brand": {
    "format": "♠",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 16,
    "separate-outputs": true
  },
  "mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "Ⅱ {title}",
    "status-icons": {
      "playing": "▶",
      "paused": "Ⅱ",
      "stopped": "■"
    },
    "max-length": 23,
    "tooltip": true,
    "tooltip-format": "{artist} — {title}\nClique: reproduzir/pausar · botão direito: Spotify",
    "on-click": "playerctl play-pause",
    "on-click-right": "spotify-launcher"
  },
  "name": "pacman",
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "custom/pacman-cava",
      "mpris"
    ]
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "CPU {temperatureC}°C",
    "tooltip-format": "Temperatura da CPU Ryzen · Tctl: {temperatureC}°C"
  },
  "custom/pacman-cava": {
    "exec": "exec python3 -u \"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/assets/pacman-cava.py\"",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "on-click": "spotify-launcher"
  }
}
