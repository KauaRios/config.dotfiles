{
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "wireplumber": {
    "format": "♪ {volume}%",
    "format-muted": "♪ ×",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "⌁",
    "format-ethernet": "⇆",
    "format-disconnected": "×",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "tooltip-format": "Temperatura da CPU Ryzen: {temperatureC}°C"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "▰ {capacity}%",
    "format-charging": "ϟ {capacity}%",
    "format-plugged": "ϟ {capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "ϟ",
      "power-saver": "♧",
      "balanced": "◐",
      "performance": "ϟ"
    },
    "tooltip-format": "Perfil de energia: {profile}\nClique para alternar entre os perfis disponíveis"
  },
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 0,
  "custom/launcher": {
    "format": "​",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "custom/spotify": {
    "format": "♫",
    "on-click": "spotify-launcher",
    "tooltip-format": "Abrir Spotify"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d.%m.%Y}",
    "tooltip-format": "<big>{:%A, %d de %B}</big>\n<tt>{calendar}</tt>"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 9
  },
  "memory": {
    "format": "{used:.1f}G",
    "interval": 5
  },
  "name": "sora",
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/spotify",
    "mpris"
  ],
  "modules-right": [
    "tray",
    "network",
    "wireplumber",
    "temperature",
    "memory",
    "power-profiles-daemon",
    "battery",
    "clock"
  ],
  "mpris": {
    "format": "{title}",
    "format-paused": "Ⅱ  {title}",
    "max-length": 27,
    "on-click": "playerctl play-pause",
    "on-click-right": "spotify-launcher",
    "tooltip-format": "{artist} — {title}"
  }
}
