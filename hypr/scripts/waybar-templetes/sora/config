{
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "—",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "​",
    "format-ethernet": "​",
    "format-disconnected": "​",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "tooltip-format": "Temperatura da CPU Ryzen: {temperatureC}°C"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "power-profiles-daemon": {
    "format": "​",
    "format-icons": {
      "default": "ϟ",
      "power-saver": "♧",
      "balanced": "◐",
      "performance": "ϟ"
    },
    "tooltip-format": "Perfil de energia: {profile}\nClique para alternar entre os perfis disponíveis"
  },
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 0,
  "custom/launcher": {
    "format": "​",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "custom/spotify": {
    "format": "​",
    "on-click": "spotify-launcher",
    "tooltip-format": "Abrir Spotify"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%H:%M:%S}",
    "tooltip-format": "<big>{:%A, %d de %B}</big>\n<tt>{calendar}</tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "name": "sora",
  "margin-top": 12,
  "margin-left": 20,
  "margin-right": 20,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/spotify",
    "mpris"
  ],
  "modules-center": [
    "clock",
    "clock#date"
  ],
  "modules-right": [
    "temperature",
    "network",
    "wireplumber",
    "power-profiles-daemon",
    "battery",
    "tray"
  ],
  "mpris": {
    "format": "{title}",
    "format-paused": "Ⅱ  {title}",
    "max-length": 20,
    "on-click": "playerctl play-pause",
    "on-click-right": "spotify-launcher",
    "tooltip-format": "{artist} — {title}"
  },
  "clock#date": {
    "format": "{:%a\n%d %b}",
    "tooltip": false
  }
}
