{
  "name": "cinder",
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 5,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 0,
  "spacing": 0,
  "modules-left": [
    "clock",
    "custom/sep#left",
    "temperature",
    "tray",
    "custom/sep#right",
    "group/active-window"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/bl",
    "group/bt",
    "group/net",
    "group/vol",
    "group/mem",
    "group/cpu-card",
    "group/bat"
  ],
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "format-alt": "{:%H:%M:%S - %a, %d %b}",
    "tooltip-format": "<big>{:%A, %d de %B}</big>\n<tt>{calendar}</tt>"
  },
  "custom/sep#left": {
    "format": "|",
    "tooltip": false
  },
  "custom/sep#right": {
    "format": "|",
    "tooltip": false
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "tooltip-format": "CPU Ryzen · Tctl: {temperatureC}°C"
  },
  "tray": {
    "icon-size": 13,
    "spacing": 5
  },
  "group/active-window": {
    "orientation": "vertical",
    "modules": [
      "hyprland/window#class",
      "hyprland/window#title"
    ]
  },
  "hyprland/window#class": {
    "format": "{class}",
    "max-length": 24,
    "separate-outputs": true,
    "fallback": "Hyprland",
    "tooltip": false
  },
  "hyprland/window#title": {
    "format": "{title}",
    "max-length": 28,
    "separate-outputs": true,
    "fallback": "Desktop",
    "tooltip-format": "{class}: {title}"
  },
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{icon}",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X",
      "default": "·"
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },
  "group/bl": {
    "orientation": "horizontal",
    "modules": [
      "custom/bl-label",
      "backlight"
    ]
  },
  "custom/bl-label": {
    "format": "BL",
    "tooltip": false
  },
  "backlight": {
    "format": "{percent}%",
    "tooltip-format": "Brilho: {percent}%",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "group/bt": {
    "orientation": "horizontal",
    "modules": [
      "custom/bt-label",
      "bluetooth"
    ]
  },
  "custom/bt-label": {
    "format": "BT",
    "tooltip": false,
    "on-click": "kcmshell6 kcm_bluetooth"
  },
  "bluetooth": {
    "format": "{status} {num_connections}",
    "format-on": "on {num_connections}",
    "format-connected": "on {num_connections}",
    "format-off": "off",
    "format-disabled": "off",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "kcmshell6 kcm_bluetooth"
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": [
      "custom/net-label",
      "network"
    ]
  },
  "custom/net-label": {
    "format": "NET",
    "tooltip": false,
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "off",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "group/vol": {
    "orientation": "horizontal",
    "modules": [
      "custom/vol-label",
      "wireplumber"
    ]
  },
  "custom/vol-label": {
    "format": "VOL",
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Volume: {volume}%\nClique: mudo · botão direito: controle de volume"
  },
  "group/mem": {
    "orientation": "horizontal",
    "modules": [
      "custom/mem-label",
      "memory"
    ]
  },
  "custom/mem-label": {
    "format": "MEM",
    "tooltip": false
  },
  "memory": {
    "format": "{percentage}%",
    "interval": 5,
    "tooltip-format": "Memória: {used:0.1f}G / {total:0.1f}G ({percentage}%)"
  },
  "group/cpu-card": {
    "orientation": "horizontal",
    "modules": [
      "custom/cpu-label",
      "cpu"
    ]
  },
  "custom/cpu-label": {
    "format": "CPU",
    "tooltip": false
  },
  "cpu": {
    "format": "{usage}%",
    "interval": 3,
    "tooltip-format": "CPU: {usage}%"
  },
  "group/bat": {
    "orientation": "horizontal",
    "modules": [
      "custom/bat-label",
      "battery"
    ]
  },
  "custom/bat-label": {
    "format": "BAT",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}%+",
    "format-plugged": "{capacity}%",
    "tooltip-format": "Bateria: {capacity}% · {timeTo}"
  }
}
