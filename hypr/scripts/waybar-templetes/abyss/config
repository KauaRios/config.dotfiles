{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 12,
  "margin-bottom": 0,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": [
    "custom/launcher",
    "hyprland/window",
    "group/audio",
    "cpu",
    "memory"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/bindings",
    "group/controls",
    "network",
    "battery",
    "clock",
    "tray"
  ],
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "clock": {
    "format": "◷ {:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "▦  {:%d.%m.%Y}",
    "interval": 60
  },
  "cpu": {
    "interval": 2,
    "format": "◈ {usage}%",
    "max-length": 10,
    "tooltip-format": "Processador: {usage}%"
  },
  "wireplumber": {
    "format": "♪ {volume}%",
    "format-muted": "×",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%"
  },
  "network": {
    "format-wifi": "⌁ {signalStrength}%",
    "format-ethernet": "⇆",
    "format-disconnected": "⌁ ×",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\nClique para configurar o Wi-Fi",
    "max-length": 12,
    "tooltip-format-disconnected": "Sem conexão · clique para configurar a rede",
    "on-click": "kcmshell6 kcm_networkmanagement"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "▰ {capacity}%",
    "format-charging": "ϟ {capacity}%",
    "format-plugged": "ϟ {capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  },
  "custom/launcher": {
    "format": "❄",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 28,
    "separate-outputs": true
  },
  "backlight": {
    "format": "☼ {percent}%",
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "☀",
      "deactivated": "☾"
    },
    "tooltip-format-activated": "Suspensão automática inibida · clique para permitir",
    "tooltip-format-deactivated": "Suspensão automática permitida · clique para inibir"
  },
  "bluetooth": {
    "format": "ᛒ",
    "format-connected": "ᛒ",
    "format-disabled": "ᛒ",
    "format-off": "ᛒ",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "Bluetooth: {device_alias}"
  },
  "memory": {
    "format": "▤ {percentage}%",
    "interval": 5
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "wireplumber#source"
    ]
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "♩ {volume}%",
    "format-muted": "♩ ×",
    "tooltip-format": "Microfone: {volume}%"
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "custom/lock",
      "idle_inhibitor",
      "custom/wallpaper"
    ]
  },
  "custom/bindings": {
    "format": "⌨ Bindings",
    "on-click": "kitty -e lua \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/cheat_sheet.lua\"",
    "tooltip-format": "Consultar atalhos"
  },
  "custom/lock": {
    "format": "⏻",
    "on-click": "hyprlock",
    "tooltip-format": "Bloquear sessão"
  },
  "custom/wallpaper": {
    "format": "▧",
    "on-click": "python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/wallpaper.py\"",
    "tooltip-format": "Escolher wallpaper"
  }
}
