{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin-top": 10,
  "margin-left": 12,
  "margin-bottom": 0,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock#date",
    "hyprland/window",
    "clock"
  ],
  "modules-right": [
    "memory",
    "temperature",
    "cpu",
    "idle_inhibitor",
    "custom/lock",
    "tray"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "clock": {
    "format": "{:%H.%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "▦  {:%d.%m.%Y}",
    "interval": 1
  },
  "cpu": {
    "interval": 2,
    "format": "◈ {usage}%",
    "max-length": 10,
    "tooltip-format": "Processador: {usage}%"
  },
  "memory": {
    "interval": 10,
    "format": "▤ {percentage}%",
    "tooltip-format": "Memória: {used:.1f} / {total:.1f} GiB"
  },
  "tray": {
    "spacing": 9,
    "icon-size": 12
  },
  "custom/lock": {
    "format": "▣",
    "on-click": "hyprlock",
    "tooltip-format": "Bloquear a sessão"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "♨ {temperatureC}°C",
    "tooltip-format": "CPU: {temperatureC}°C"
  },
  "custom/launcher": {
    "format": "Λ",
    "on-click": "rofi -show drun",
    "tooltip-format": "Abrir aplicativos"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 34,
    "separate-outputs": true
  },
  "clock#date": {
    "format": "{:%Y/%m/%d}",
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "●",
      "deactivated": "○"
    },
    "tooltip-format-activated": "Suspensão automática inibida",
    "tooltip-format-deactivated": "Suspensão automática permitida"
  }
}
