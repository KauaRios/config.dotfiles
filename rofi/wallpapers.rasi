/* Galeria de wallpapers: tema independente do launcher de aplicativos. */
@import "colors.rasi"

* {
    font: "DejaVu Sans 11";
    background-color: transparent;
    text-color: @fg;
    border-color: @accent;
}
window {
    location: center;
    anchor: center;
    width: 900px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 3px;
    padding: 28px;
    children: [ mainbox ];
}
mainbox { orientation: vertical; children: [ listview ]; }
listview {
    columns: 4;
    lines: 1;
    flow: horizontal;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    cycle: true;
    spacing: 20px;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    background-color: @bg;
    border: 1px;
    border-color: @bg;
    border-radius: 2px;
    padding: 24px 12px 18px;
    spacing: 22px;
}
element selected.normal, element selected.active {
    background-color: @accent;
    border-color: @accent;
    text-color: @bg;
}
element-icon {
    size: 150px;
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "DejaVu Sans 9";
}
@media (max-width: 1100px) {
    window { width: 92%; padding: 18px; }
    element-icon { size: 130px; }
    listview { spacing: 12px; }
}
@media (max-width: 700px) {
    listview { columns: 2; }
    element-icon { size: 110px; }
}
