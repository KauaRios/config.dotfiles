/* Tema adaptado de di0gosilva/hyprland-dotfiles:
 * https://github.com/di0gosilva/hyprland-dotfiles
 * Adaptação local: integração com a paleta dinâmica.
 */
configuration {
    show-icons: true;
}
@import "colors.rasi"

* {
    font: "DejaVu Sans 11";
    background: @bg;
    background-alt: @bg;
    selected: @accent;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 900px;
    border: 1px solid;
    border-radius: 2px;
    border-color: @selected;
    background-color: @background;
}

mainbox {
    spacing: 0px;
    padding: 30px;
    background-color: @background;
    children: [ "listview" ];
}

listview {
    columns: 4;
    lines: 1;
    spacing: 20px;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
    scrollbar: false;
    background-color: @background;
}

element {
    orientation: vertical;
    padding: 20px;
    border-radius: 2px;
    background-color: @background-alt;
    text-color: @background;
}

element normal.normal {
    background-color: @background-alt;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-icon {
    size: 160px;
    border-radius: 6px;
    background-color: transparent;
}

element-text {
    margin: 10px 0px 0px 0px;
    horizontal-align: 0.5;
    background-color: @background-alt;
    text-color: @selected;
}

element-text selected.normal {
    background-color: @selected;
    text-color: @background-alt;
}
