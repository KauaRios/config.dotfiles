{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 10,
  "margin-bottom": 0,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "wireplumber",
    "network",
    "power-profiles-daemon",
    "battery",
    "tray",
    "custom/lock"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "format-icons": {
      "1": "μ",
      "2": "π",
      "3": "σ",
      "4": "τ",
      "5": "λ",
      "6": "α",
      "7": "β",
      "8": "γ",
      "9": "δ",
      "10": "ζ"
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "clock": {
    "format": "{:%H:%M  /  %d.%m}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 10,
    "format": "RAM {used:.1f}G",
    "tooltip-format": "Memória: {used:.1f} / {total:.1f} GiB"
  },
  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "network": {
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "LINK",
    "format-disconnected": "OFFLINE",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signaldBm}dBm)",
    "max-length": 20
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT +{capacity}%",
    "format-plugged": "BAT {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "spacing": 8
  },
  "custom/launcher": {
    "format": "◆  MENU",
    "on-click": "rofi -show drun",
    "tooltip": false
  },
  "custom/lock": {
    "format": "BLOQUEAR",
    "on-click": "hyprlock"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "power-saver": "ECO",
      "balanced": "NORMAL",
      "performance": "TURBO"
    },
    "tooltip-format": "Energia: {profile}\nClique para trocar o perfil"
  }
}
