{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin-top": 6,
  "margin-left": 10,
  "margin-bottom": 0,
  "margin-right": 10,
  "spacing": 5,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "wireplumber",
    "network",
    "cpu",
    "memory",
    "power-profiles-daemon",
    "battery",
    "clock",
    "custom/lock"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "clock": {
    "format": "{:%a %d %b  ·  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "▦  {:%d.%m.%Y}"
  },
  "cpu": {
    "interval": 2,
    "format": "{usage}% ⚙",
    "max-length": 10,
    "tooltip-format": "Processador: {usage}%"
  },
  "memory": {
    "interval": 10,
    "format": "{used:.1f}G ▤",
    "tooltip-format": "Memória: {used:.1f} / {total:.1f} GiB"
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "♩  —",
    "format-icons": [
      "♩",
      "♪",
      "♫"
    ],
    "tooltip-format": "Volume: {volume}%"
  },
  "network": {
    "format-wifi": "⌁ {essid}",
    "format-ethernet": "⇆ {ifname}",
    "format-disconnected": "⊘",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signaldBm}dBm)",
    "max-length": 20,
    "tooltip-format-disconnected": "Sem conexão"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "ϟ  {capacity}%",
    "format-plugged": "ϟ  {capacity}%",
    "format-icons": [
      "▱",
      "▱",
      "▰",
      "▰",
      "▰"
    ]
  },
  "tray": {
    "spacing": 8,
    "icon-size": 14
  },
  "custom/lock": {
    "format": "⏻",
    "on-click": "hyprlock",
    "tooltip-format": "Bloquear a sessão"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "power-saver": "♧",
      "balanced": "◐",
      "performance": "ϟ"
    },
    "tooltip-format": "Energia: {profile}\nClique para trocar o perfil"
  }
}
