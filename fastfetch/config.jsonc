{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/Queen Marika-transparent.png\"",
    "width": 26,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4
    },
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#9ed49d",
      "title": "#b9ccb5",
      "output": "#e0e4db"
    },
    "showErrors": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;158;212;157}          M A R I K A{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;185;204;181}        THE ETERNAL QUEEN{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;140;147;137}  ─────────── ◇ ───────────{#}"
    },
    "break",
    {
      "type": "title",
      "key": "  Tarnished",
      "format": "{user-name}"
    },
    {
      "type": "os",
      "key": "  Realm    ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "  Kernel   ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  Session  ",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  Terminal "
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;185;204;181}  ◇  VITALS{#}"
    },
    {
      "type": "cpu",
      "key": "  CPU      ",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "  Heat     ",
      "temp": true,
      "format": "{temperature}"
    },
    {
      "type": "memory",
      "key": "  Memory   ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "  Storage  ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": "  Awake    "
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;140;147;137}  ─────────── ◇ ───────────{#}"
    },
    {
      "type": "custom",
      "format": "  {#38;2;158;212;157}● ● ●{#}   {#38;2;185;204;181}● ● ●{#}   {#38;2;140;147;137}● ● ●{#}"
    }
  ]
}
