{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/Queen Marika the Eternal, Ruan Zoe.jpg\"",
    "width": 28,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    },
    "position": "left"
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "#9ed49d",
      "title": "#b9ccb5",
      "output": "#e0e4db"
    },
    "showErrors": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;158;212;157}╭─ SYSTEM ────────────────────────────────────────────────────╮{#}"
    },
    {
      "type": "title",
      "key": "│ User     ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "│ OS       ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "│ Kernel   "
    },
    {
      "type": "packages",
      "key": "│ Packages "
    },
    {
      "type": "display",
      "key": "│ Display  ",
      "format": "{width}x{height}"
    },
    {
      "type": "terminal",
      "key": "│ Terminal "
    },
    {
      "type": "shell",
      "key": "│ Shell    "
    },
    {
      "type": "wm",
      "key": "│ WM       "
    },
    {
      "type": "custom",
      "format": "{#38;2;158;212;157}╰─────────────────────────────────────────────────────────────╯{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;158;212;157}╭─ HARDWARE ──────────────────────────────────────────────────╮{#}"
    },
    {
      "type": "cpu",
      "key": "│ CPU      ",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "│ CPU temp ",
      "temp": true,
      "format": "{temperature}"
    },
    {
      "type": "gpu",
      "key": "│ GPU      ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ Memory   ",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "│ Disk /   ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": "│ Uptime   "
    },
    {
      "type": "custom",
      "format": "{#38;2;158;212;157}╰─────────────────────────────────────────────────────────────╯{#}"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
